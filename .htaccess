# =============================================================================
# CyFocus — production configuration for Apache / LiteSpeed (Hostinger)
# Upload this file together with the site. The same security headers are
# mirrored in `_headers` for Cloudflare Pages / Netlify. Keep both in sync.
# GitHub Pages ignores this file (and `_headers`); there the CSP comes from the
# <meta> tag in each page and the deploy workflow doesn't publish either file.
# =============================================================================

# No directory listings; don't advertise the server version
Options -Indexes
ServerSignature Off
DirectoryIndex index.html

# Custom error page (403 shows the same page so blocked files don't reveal they exist)
ErrorDocument 403 /404.html
ErrorDocument 404 /404.html

AddDefaultCharset utf-8
<IfModule mod_mime.c>
  AddCharset utf-8 .html .css .js .txt .xml .webmanifest
  AddType image/webp .webp
  AddType application/manifest+json .webmanifest
</IfModule>

# -----------------------------------------------------------------------------
# Rewrites: HTTPS, canonical host, read-only methods
# -----------------------------------------------------------------------------
<IfModule mod_rewrite.c>
  RewriteEngine On

  # A static site only needs read-only methods (blocks TRACE, PUT, DELETE, POST probes…)
  RewriteCond %{REQUEST_METHOD} !^(GET|HEAD|OPTIONS)$
  RewriteRule .* - [R=405,L]

  # Force HTTPS (also correct behind Hostinger's / Cloudflare's proxy)
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

  # Canonical host: www.cyfocus.in -> cyfocus.in
  RewriteCond %{HTTP_HOST} ^www\.cyfocus\.in$ [NC]
  RewriteRule ^ https://cyfocus.in%{REQUEST_URI} [R=301,L]

  # /index.html -> / (matches the canonical URL)
  RewriteCond %{THE_REQUEST} \s/index\.html[\s?] [NC]
  RewriteRule ^index\.html$ / [R=301,L]
</IfModule>

# -----------------------------------------------------------------------------
# Hide anything that isn't part of the public site
# -----------------------------------------------------------------------------
# Hidden files/folders (.htaccess, .git, .claude, .DS_Store…) except /.well-known/
RedirectMatch 404 /\.(?!well-known/)
# Source, backup, config and archive files
RedirectMatch 404 (?i)\.(md|bak|old|orig|save|swp|tmp|log|sh|py|mjs|sql|sqlite|zip|tar|gz|7z|rar|ini|conf|cfg|env|yml|yaml|lock|psd|ai)$
# Host-specific config file used by Cloudflare Pages / Netlify
RedirectMatch 404 ^/_headers$

# -----------------------------------------------------------------------------
# Security headers
# -----------------------------------------------------------------------------
<IfModule mod_headers.c>
  # Same policy as the <meta> CSP in every page (GitHub Pages needs the meta copy), plus frame-ancestors,
  # which only works as a header. Everything is self-hosted; the only third party is the Contact page map.
  Header always set Content-Security-Policy "default-src 'none'; script-src 'self'; style-src 'self'; font-src 'self'; img-src 'self' data:; manifest-src 'self'; connect-src 'none'; frame-src https://maps.google.com https://www.google.com; form-action mailto:; base-uri 'none'; frame-ancestors 'self'; object-src 'none'; upgrade-insecure-requests; require-trusted-types-for 'script'; trusted-types 'none'"
  # Browsers remember to use HTTPS only for a year (applies to subdomains too)
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "accelerometer=(), camera=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), payment=(), usb=(), browsing-topics=()"
  Header always set Cross-Origin-Opener-Policy "same-origin"
  Header always set Cross-Origin-Resource-Policy "same-origin"
  Header always set X-Permitted-Cross-Domain-Policies "none"
  Header always unset X-Powered-By
  Header unset X-Powered-By

  # Pages always revalidate so updates appear immediately
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>

# -----------------------------------------------------------------------------
# Performance: compression and caching
# (CSS/JS links carry a ?v= version — bump it whenever those files change)
# -----------------------------------------------------------------------------
<IfModule mod_brotli.c>
  AddOutputFilterByType BROTLI_COMPRESS text/html text/css application/javascript text/javascript application/json application/manifest+json image/svg+xml text/xml application/xml text/plain
</IfModule>
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript text/javascript application/json application/manifest+json image/svg+xml text/xml application/xml text/plain
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 week"
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType text/css "access plus 1 week"
  ExpiresByType application/javascript "access plus 1 week"
  ExpiresByType text/javascript "access plus 1 week"
  ExpiresByType image/webp "access plus 1 month"
  ExpiresByType image/png "access plus 1 month"
  ExpiresByType image/jpeg "access plus 1 month"
  ExpiresByType image/x-icon "access plus 1 month"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType application/manifest+json "access plus 1 week"
</IfModule>
